@prefix dino: <http://example.org/dino#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# =====================================================================
# Ontologia de Dinossauros, clados e tempo geologico
# =====================================================================

<http://example.org/dino> a owl:Ontology ;
    rdfs:label "Dinossauros e Clados"@pt ;
    rdfs:comment "Base de conhecimento sobre dinossauros: taxonomia por clados, intervalos geologicos (Era > Periodo > Epoca), formacoes onde foram encontrados e paleontologos que os descreveram."@pt .

# =====================================================================
# CLASSES: taxonomia de dinossauros (clados)
# Raiz: Dinossauro. Profundidade maxima: 4 niveis abaixo da raiz
# (Dinossauro > Saurischia > Theropoda > Coelurosauria > Tyrannosauridae).
# Especies sao modeladas como individuos da classe do clado mais
# especifico conhecido; a pertinencia aos clados superiores e inferida
# por rdfs:subClassOf.
# =====================================================================

dino:Dinossauro a owl:Class ;
    rdfs:label "Dinossauro"@pt ;
    rdfs:comment "Clado Dinosauria: ultimo ancestral comum de Triceratops e aves modernas e todos os seus descendentes."@pt .

# --- Saurischia ("quadril de lagarto") --------------------------------
dino:Saurischia a owl:Class ;
    rdfs:subClassOf dino:Dinossauro ;
    rdfs:label "Saurischia"@pt ;
    rdfs:comment "Dinossauros com pube voltado para frente (quadril de lagarto)."@pt .

dino:Theropoda a owl:Class ;
    rdfs:subClassOf dino:Saurischia ;
    rdfs:label "Theropoda"@pt ;
    rdfs:comment "Saurisquios bipedes, em sua maioria carnivoros; inclui as aves."@pt .

dino:Ceratosauria a owl:Class ;
    rdfs:subClassOf dino:Theropoda ;
    rdfs:label "Ceratosauria"@pt ;
    rdfs:comment "Teropodes de linhagem antiga, muitos com chifres ou cristas no cranio."@pt .

dino:Abelisauridae a owl:Class ;
    rdfs:subClassOf dino:Ceratosauria ;
    rdfs:label "Abelisauridae"@pt ;
    rdfs:comment "Ceratossauros de cranio curto e bracos atrofiados, comuns no Gondwana."@pt .

dino:Coelurosauria a owl:Class ;
    rdfs:subClassOf dino:Theropoda ;
    rdfs:label "Coelurosauria"@pt ;
    rdfs:comment "Teropodes mais proximos das aves; muitos tinham penas."@pt .

dino:Tyrannosauridae a owl:Class ;
    rdfs:subClassOf dino:Coelurosauria ;
    rdfs:label "Tyrannosauridae"@pt .

dino:Ornithomimosauria a owl:Class ;
    rdfs:subClassOf dino:Coelurosauria ;
    rdfs:label "Ornithomimosauria"@pt ;
    rdfs:comment "Celurossauros corredores, de bico sem dentes, parecidos com avestruzes."@pt .

dino:Dromaeosauridae a owl:Class ;
    rdfs:subClassOf dino:Coelurosauria ;
    rdfs:label "Dromaeosauridae"@pt ;
    rdfs:comment "Teropodes 'raptores', com garra em foice no segundo dedo do pe."@pt .

dino:Spinosauridae a owl:Class ;
    rdfs:subClassOf dino:Theropoda ;
    rdfs:label "Spinosauridae"@pt ;
    rdfs:comment "Teropodes de focinho alongado, adaptados a captura de peixes."@pt .

dino:Allosauroidea a owl:Class ;
    rdfs:subClassOf dino:Theropoda ;
    rdfs:label "Allosauroidea"@pt .

dino:Carcharodontosauridae a owl:Class ;
    rdfs:subClassOf dino:Allosauroidea ;
    rdfs:label "Carcharodontosauridae"@pt ;
    rdfs:comment "Alossauroides gigantes, com dentes laminados como os de tubarao."@pt .

dino:Sauropodomorpha a owl:Class ;
    rdfs:subClassOf dino:Saurischia ;
    rdfs:label "Sauropodomorpha"@pt ;
    rdfs:comment "Saurisquios herbivoros de pescoco longo."@pt .

dino:Sauropoda a owl:Class ;
    rdfs:subClassOf dino:Sauropodomorpha ;
    rdfs:label "Sauropoda"@pt ;
    rdfs:comment "Sauropodomorfos quadrupedes gigantes."@pt .

dino:Diplodocidae a owl:Class ;
    rdfs:subClassOf dino:Sauropoda ;
    rdfs:label "Diplodocidae"@pt ;
    rdfs:comment "Sauropodes longos e esguios, com cauda em chicote."@pt .

dino:Titanosauria a owl:Class ;
    rdfs:subClassOf dino:Sauropoda ;
    rdfs:label "Titanosauria"@pt ;
    rdfs:comment "Sauropodes do Cretaceo, incluindo os maiores animais terrestres conhecidos."@pt .

# --- Ornithischia ("quadril de ave") ----------------------------------
dino:Ornithischia a owl:Class ;
    rdfs:subClassOf dino:Dinossauro ;
    rdfs:label "Ornithischia"@pt ;
    rdfs:comment "Dinossauros com pube voltado para tras (quadril de ave); predominantemente herbivoros."@pt .

dino:Ornithopoda a owl:Class ;
    rdfs:subClassOf dino:Ornithischia ;
    rdfs:label "Ornithopoda"@pt .

dino:Hadrosauridae a owl:Class ;
    rdfs:subClassOf dino:Ornithopoda ;
    rdfs:label "Hadrosauridae"@pt ;
    rdfs:comment "Ornitopodes de bico de pato, com baterias de centenas de dentes."@pt .

dino:Ceratopsia a owl:Class ;
    rdfs:subClassOf dino:Ornithischia ;
    rdfs:label "Ceratopsia"@pt ;
    rdfs:comment "Ornitisquios com bico rostral e, em geral, chifres e babados."@pt .

dino:Ceratopsidae a owl:Class ;
    rdfs:subClassOf dino:Ceratopsia ;
    rdfs:label "Ceratopsidae"@pt ;
    rdfs:comment "Ceratopsios grandes e quadrupedes, com chifres e babado osseo desenvolvidos."@pt .

dino:Pachycephalosauria a owl:Class ;
    rdfs:subClassOf dino:Ornithischia ;
    rdfs:label "Pachycephalosauria"@pt ;
    rdfs:comment "Ornitisquios bipedes com o teto do cranio espessado em domo."@pt .

dino:Thyreophora a owl:Class ;
    rdfs:subClassOf dino:Ornithischia ;
    rdfs:label "Thyreophora"@pt ;
    rdfs:comment "Ornitisquios encouracados."@pt .

dino:Stegosauria a owl:Class ;
    rdfs:subClassOf dino:Thyreophora ;
    rdfs:label "Stegosauria"@pt .

dino:Ankylosauria a owl:Class ;
    rdfs:subClassOf dino:Thyreophora ;
    rdfs:label "Ankylosauria"@pt .

# OWL 1: Saurischia e Ornithischia sao as duas linhagens que dividem
# Dinosauria; nenhuma especie pertence as duas.
dino:Saurischia owl:disjointWith dino:Ornithischia .

# OWL 2: classe definida. Predador e qualquer dinossauro com ao menos
# um registro de predacao sobre outro dinossauro (necessario e suficiente).
dino:Predador a owl:Class ;
    rdfs:subClassOf dino:Dinossauro ;
    rdfs:label "Predador"@pt ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty dino:predouSobre ;
        owl:someValuesFrom dino:Dinossauro
    ] .

# =====================================================================
# CLASSES: tempo geologico
# =====================================================================

dino:IntervaloGeologico a owl:Class ;
    rdfs:label "Intervalo geologico"@pt ;
    rdfs:comment "Unidade da escala de tempo geologico (ICS)."@pt .

dino:Era a owl:Class ;
    rdfs:subClassOf dino:IntervaloGeologico ;
    rdfs:label "Era"@pt .

dino:Periodo a owl:Class ;
    rdfs:subClassOf dino:IntervaloGeologico ;
    rdfs:label "Periodo"@pt .

dino:Epoca a owl:Class ;
    rdfs:subClassOf dino:IntervaloGeologico ;
    rdfs:label "Epoca"@pt .

# OWL 3: um intervalo tem uma unica posicao hierarquica na escala.
[] a owl:AllDisjointClasses ;
    owl:members ( dino:Era dino:Periodo dino:Epoca ) .

# =====================================================================
# CLASSES: contexto (onde e por quem)
# =====================================================================

dino:FormacaoGeologica a owl:Class ;
    rdfs:label "Formacao geologica"@pt ;
    rdfs:comment "Unidade rochosa onde fosseis foram encontrados."@pt .

dino:Pais a owl:Class ;
    rdfs:label "Pais"@pt .

dino:Paleontologo a owl:Class ;
    rdfs:label "Paleontologo"@pt .

# =====================================================================
# PROPRIEDADES DE OBJETO
# =====================================================================

# OWL 4: subperiodoDe e transitiva. Jurassico Superior subperiodoDe
# Jurassico, Jurassico subperiodoDe Mesozoico  =>  Jurassico Superior
# subperiodoDe Mesozoico.
dino:subperiodoDe a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "subperiodo de"@pt ;
    rdfs:domain dino:IntervaloGeologico ;
    rdfs:range dino:IntervaloGeologico .

dino:temSubperiodo a owl:ObjectProperty ;
    rdfs:label "tem subperiodo"@pt ;
    owl:inverseOf dino:subperiodoDe ;
    rdfs:domain dino:IntervaloGeologico ;
    rdfs:range dino:IntervaloGeologico .

# OWL 5: cadeia de propriedades. Quem viveu numa epoca viveu tambem no
# periodo e na era que a contem: viveuEm o subperiodoDe -> viveuEm.
# (Equivale a "viveuEm transitiva ao longo da escala de tempo", mas
# respeitando domain Dinossauro / range IntervaloGeologico.)
dino:viveuEm a owl:ObjectProperty ;
    rdfs:label "viveu em"@pt ;
    rdfs:domain dino:Dinossauro ;
    rdfs:range dino:IntervaloGeologico ;
    owl:propertyChainAxiom ( dino:viveuEm dino:subperiodoDe ) .

dino:encontradoEm a owl:ObjectProperty ;
    rdfs:label "encontrado em"@pt ;
    rdfs:domain dino:Dinossauro ;
    rdfs:range dino:FormacaoGeologica .

# OWL 6: cada formacao (nesta base) pertence a um unico pais.
dino:localizadaEm a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "localizada em"@pt ;
    rdfs:domain dino:FormacaoGeologica ;
    rdfs:range dino:Pais .

dino:formacaoDatadaEm a owl:ObjectProperty ;
    rdfs:label "formacao datada em"@pt ;
    rdfs:domain dino:FormacaoGeologica ;
    rdfs:range dino:IntervaloGeologico .

# OWL 7: descritoPor / descreveu sao inversas.
dino:descritoPor a owl:ObjectProperty ;
    rdfs:label "descrito por"@pt ;
    rdfs:domain dino:Dinossauro ;
    rdfs:range dino:Paleontologo .

dino:descreveu a owl:ObjectProperty ;
    rdfs:label "descreveu"@pt ;
    owl:inverseOf dino:descritoPor ;
    rdfs:domain dino:Paleontologo ;
    rdfs:range dino:Dinossauro .

# OWL 8: predacao so e registrada para teropodes; presaDe e a inversa.
# Assimetrica: se A predou B, B nao predou A (nao ha registro fossil de
# predacao reciproca entre as especies da base).
dino:predouSobre a owl:ObjectProperty , owl:AsymmetricProperty ;
    rdfs:label "predou sobre"@pt ;
    rdfs:comment "Ha evidencia fossil (marcas de mordida, associacao direta) de predacao."@pt ;
    rdfs:domain dino:Theropoda ;
    rdfs:range dino:Dinossauro .

dino:presaDe a owl:ObjectProperty ;
    rdfs:label "presa de"@pt ;
    owl:inverseOf dino:predouSobre ;
    rdfs:domain dino:Dinossauro ;
    rdfs:range dino:Theropoda .

# =====================================================================
# PROPRIEDADES DE DADOS
# =====================================================================

# OWL 9: uma especie tem exatamente um nome cientifico valido.
dino:nomeCientifico a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nome cientifico"@pt ;
    rdfs:domain dino:Dinossauro ;
    rdfs:range xsd:string .

dino:comprimentoMetros a owl:DatatypeProperty ;
    rdfs:label "comprimento (m)"@pt ;
    rdfs:domain dino:Dinossauro ;
    rdfs:range xsd:decimal .

dino:massaToneladas a owl:DatatypeProperty ;
    rdfs:label "massa (t)"@pt ;
    rdfs:domain dino:Dinossauro ;
    rdfs:range xsd:decimal .

# Funcional: a descricao formal de uma especie ocorre em um unico ano.
dino:anoDescricao a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ano da descricao"@pt ;
    rdfs:domain dino:Dinossauro ;
    rdfs:range xsd:integer .

dino:dieta a owl:DatatypeProperty ;
    rdfs:label "dieta"@pt ;
    rdfs:domain dino:Dinossauro ;
    rdfs:range xsd:string .

dino:inicioMa a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inicio (milhoes de anos atras)"@pt ;
    rdfs:domain dino:IntervaloGeologico ;
    rdfs:range xsd:decimal .

dino:fimMa a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fim (milhoes de anos atras)"@pt ;
    rdfs:domain dino:IntervaloGeologico ;
    rdfs:range xsd:decimal .

# =====================================================================
# INDIVIDUOS: escala de tempo (datas ICS, em Ma)
# =====================================================================

dino:Mesozoico a dino:Era ;
    rdfs:label "Mesozoico"@pt ; dino:inicioMa 251.9 ; dino:fimMa 66.0 .

dino:Triassico a dino:Periodo ;
    rdfs:label "Triassico"@pt ; dino:inicioMa 251.9 ; dino:fimMa 201.4 ;
    dino:subperiodoDe dino:Mesozoico .

dino:Jurassico a dino:Periodo ;
    rdfs:label "Jurassico"@pt ; dino:inicioMa 201.4 ; dino:fimMa 143.1 ;
    dino:subperiodoDe dino:Mesozoico .

dino:Cretaceo a dino:Periodo ;
    rdfs:label "Cretaceo"@pt ; dino:inicioMa 143.1 ; dino:fimMa 66.0 ;
    dino:subperiodoDe dino:Mesozoico .

dino:TriassicoMedio a dino:Epoca ;
    rdfs:label "Triassico Medio"@pt ; dino:inicioMa 247.2 ; dino:fimMa 237.0 ;
    dino:subperiodoDe dino:Triassico .

dino:TriassicoSuperior a dino:Epoca ;
    rdfs:label "Triassico Superior"@pt ; dino:inicioMa 237.0 ; dino:fimMa 201.4 ;
    dino:subperiodoDe dino:Triassico .

dino:JurassicoInferior a dino:Epoca ;
    rdfs:label "Jurassico Inferior"@pt ; dino:inicioMa 201.4 ; dino:fimMa 174.7 ;
    dino:subperiodoDe dino:Jurassico .

dino:JurassicoMedio a dino:Epoca ;
    rdfs:label "Jurassico Medio"@pt ; dino:inicioMa 174.7 ; dino:fimMa 161.5 ;
    dino:subperiodoDe dino:Jurassico .

dino:JurassicoSuperior a dino:Epoca ;
    rdfs:label "Jurassico Superior"@pt ; dino:inicioMa 161.5 ; dino:fimMa 143.1 ;
    dino:subperiodoDe dino:Jurassico .

dino:CretaceoInferior a dino:Epoca ;
    rdfs:label "Cretaceo Inferior"@pt ; dino:inicioMa 143.1 ; dino:fimMa 100.5 ;
    dino:subperiodoDe dino:Cretaceo .

dino:CretaceoSuperior a dino:Epoca ;
    rdfs:label "Cretaceo Superior"@pt ; dino:inicioMa 100.5 ; dino:fimMa 66.0 ;
    dino:subperiodoDe dino:Cretaceo .

# =====================================================================
# INDIVIDUOS: paises e formacoes
# =====================================================================

dino:Brasil    a dino:Pais ; rdfs:label "Brasil"@pt .
dino:Argentina a dino:Pais ; rdfs:label "Argentina"@pt .
dino:EUA       a dino:Pais ; rdfs:label "Estados Unidos"@pt .
dino:Mongolia  a dino:Pais ; rdfs:label "Mongolia"@pt .
dino:Egito     a dino:Pais ; rdfs:label "Egito"@pt .
dino:Belgica   a dino:Pais ; rdfs:label "Belgica"@pt .
dino:Canada    a dino:Pais ; rdfs:label "Canada"@pt .
dino:China     a dino:Pais ; rdfs:label "China"@pt .
dino:Alemanha  a dino:Pais ; rdfs:label "Alemanha"@pt .
dino:ReinoUnido a dino:Pais ; rdfs:label "Reino Unido"@pt .
dino:Madagascar a dino:Pais ; rdfs:label "Madagascar"@pt .
