dino:KemKem a dino:FormacaoGeologica ; rdfs:label "Grupo Kem Kem"@pt ;
    dino:localizadaEm dino:Marrocos ; dino:formacaoDatadaEm dino:CretaceoSuperior .
dino:DinosaurPark a dino:FormacaoGeologica ; rdfs:label "Formacao Dinosaur Park"@pt ;
    dino:localizadaEm dino:Canada ; dino:formacaoDatadaEm dino:CretaceoSuperior .
dino:HorseshoeCanyon a dino:FormacaoGeologica ; rdfs:label "Formacao Horseshoe Canyon"@pt ;
