dino:TwoMedicine a dino:FormacaoGeologica ; rdfs:label "Formacao Two Medicine"@pt ;
    dino:localizadaEm dino:EUA ; dino:formacaoDatadaEm dino:CretaceoSuperior .
dino:Nemegt a dino:FormacaoGeologica ; rdfs:label "Formacao Nemegt"@pt ;
